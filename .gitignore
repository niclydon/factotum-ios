# CocoaPods
Pods/

# Environment
.env
.env.*

# Signing material — never check into git. Cert lives in the secrets vault.
*.p12
*.cer
*.mobileprovision
*.provisionprofile
*.p8

# Python bytecode — asc-create-profiles.py is loaded as a module by the
# ASC build-status polling snippet, which leaves __pycache__/ on the build Mac.
__pycache__/
*.pyc

